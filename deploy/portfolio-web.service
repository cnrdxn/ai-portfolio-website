[Unit]
Description=Connor Dixon portfolio website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=portfolio-web
Group=portfolio-web
ExecStart=/usr/local/bin/portfolio-caddy run --config /etc/portfolio-web/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=portfolio-web
Environment=XDG_DATA_HOME=/var/lib/portfolio-web
Environment=XDG_CONFIG_HOME=/var/lib/portfolio-web

[Install]
WantedBy=multi-user.target
